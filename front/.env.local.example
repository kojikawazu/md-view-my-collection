# front/.env.local のテンプレート。
# このファイルをコピーして `front/.env.local` を作成し、実値を設定してください。
#   cp .env.local.example .env.local
# `.env.local` は .gitignore 対象です。実値（シークレット）はコミットしないこと。

# --- 本番（supabase モード）で必須 ---

# Supabase API URL（クライアント公開）
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key（クライアント公開）
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth のリダイレクト先（例: 本番は https://your-domain）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 管理者メール許可リスト（カンマ区切りで複数可）。サーバー専用 — NEXT_PUBLIC_ を付けない
ADMIN_EMAIL=admin@example.com

# Supabase Postgres 接続文字列（Prisma が参照）。サーバー専用
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- E2E / ローカル動作モード（任意）---
# 値を local にすると、Supabase を使わず localStorage のダミーデータで動作する。
# 初見で UI を確認する場合に便利。
# NEXT_PUBLIC_AUTH_MODE=local
# NEXT_PUBLIC_DATA_MODE=local
