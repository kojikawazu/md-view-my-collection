{
  // ドキュメントの Markdown lint 設定。
  // 方針: `static-analysis.md` に従い「守れないルールは有効にしない（警告ゼロを維持する）」。
  // 見た目・体裁の好みではなく、リンク切れや構造の壊れなど「読めなくなる」欠陥だけを検出する。
  "config": {
    // 日本語の文章は 1 行が長くなるのが自然で、機械的な折り返しは差分を汚すだけのため無効化する。
    "MD013": false,
    // テーブルのパイプ前後の空白は Prettier 等の整形対象。Linter で二重に見ない（Formatter と役割を重ねない）。
    "MD060": false,
    // 装飾目的の生 HTML（<br> 等）を docs 内で使うため許可する。
    "MD033": false,
    // 1 行目が h1 でないファイル（frontmatter を持つルールファイル等）を許容する。
    "MD041": false,
    // 同一見出し名の重複は、章立ての異なるセクションで正当に発生するため許容する。
    "MD024": { "siblings_only": true },
    // docs/08・docs/10 は複数の調査レポート・テスト設計書を 1 ファイルに収録した文書で、
    // 収録元それぞれが自分の h1 を保持する構造が正しい。構造上正当なため無効化する。
    "MD025": false
  },
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    // base/ は参照用の原本で変更禁止のため、lint の対象外とする（CLAUDE.md）。
    "base/**"
  ]
}
